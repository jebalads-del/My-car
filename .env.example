# Shared Supabase project used by sayarty.store and the mobile app.
# Keep the real values in Webdev protected environment configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional only for native builds; web uses same-origin /api requests.
EXPO_PUBLIC_WEBSITE_API_URL=
